<!-- app/views/students/index.html.erb -->

<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-purple-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <h1 class="text-4xl font-bold bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">Students</h1>
        <%= button_to "Sign out",
    destroy_student_session_path,
    method: :delete,
    data: { turbo_confirm: "Are you sure you want to sign out?" } %>
      </div>
      <%= link_to "➕ Add New Student", new_student_path, class: "bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-semibold px-6 py-3 rounded-lg transition duration-200 transform hover:shadow-lg hover:scale-105" %>
    </div>

    <!-- Success Message -->
    <% if notice %>
      <div class="mb-6 bg-emerald-50 border border-emerald-200 rounded-lg p-4 flex items-center gap-3">
        <span class="text-emerald-800 font-medium"><%= notice %></span>
      </div>
    <% end %>

    <!-- Main Card -->
    <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100">
      
      <!-- Table Container -->
      <div class="overflow-x-auto">
        <% if @students.any? %>
          <table class="w-full divide-y divide-gray-200">
            <thead>
              <tr class="bg-gradient-to-r from-gray-50 to-gray-50 border-b-2 border-indigo-100">
                <th class="px-6 py-4 text-left">
                  <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Name</span>
                </th>
                <th class="px-6 py-4 text-left">
                  <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Age</span>
                </th>
                <th class="px-6 py-4 text-left">
                  <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Email</span>
                </th>
                <th class="px-6 py-4 text-right">
                  <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @students.each do |student| %>
                <tr class="hover:bg-indigo-50 transition duration-200 group">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="text-sm font-semibold text-gray-900"><%= student.name %></span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-indigo-100 text-indigo-800">
                      <%= student.age %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="text-sm text-gray-600"><%= student.email %></span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right space-x-2">
                    <%= link_to "👁 View", student_path(student), class: "inline-flex items-center gap-1 px-3 py-2 text-sm font-medium bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200 transition duration-200" %>
                    <%= link_to "✏️ Edit", edit_student_path(student), class: "inline-flex items-center gap-1 px-3 py-2 text-sm font-medium bg-amber-100 text-amber-700 rounded-lg hover:bg-amber-200 transition duration-200" %>
                    <%= link_to "🗑️ Delete", student_path(student), method: :delete, data: { confirm: "Are you sure?" }, class: "inline-flex items-center gap-1 px-3 py-2 text-sm font-medium bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition duration-200" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="flex flex-col items-center justify-center py-16 px-4">
            <svg class="w-16 h-16 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
            <h3 class="text-xl font-semibold text-gray-700 mb-2">No students found</h3>
            <p class="text-gray-500 mb-6">Get started by adding your first student</p>
            <%= link_to "➕ Add New Student", new_student_path, class: "bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-semibold px-6 py-3 rounded-lg transition duration-200" %>
          </div>
          
        <% end %>
      </div>
    </div>
  </div>
</div>