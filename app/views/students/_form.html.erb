<%= form_with(model: @student, local: true) do |f| %>
  <% if @student.errors.any? %>
    <div class="mb-4 text-red-600">
      <h2><%= pluralize(@student.errors.count, "error") %> prohibited this student from being saved:</h2>
      <ul>
        <% @student.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :name, class: "block font-bold" %>
    <%= f.text_field :name, class: "border p-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= f.label :age, class: "block font-bold" %>
    <%= f.number_field :age, class: "border p-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= f.label :email, class: "block font-bold" %>
    <%= f.email_field :email, class: "border p-2 w-full" %>
  </div>

  <div>
    <%= f.submit class: "bg-blue-600 text-white px-4 py-2 rounded" %>
  </div>
<% end %>
