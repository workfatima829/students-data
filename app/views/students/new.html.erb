<!-- app/views/students/new.html.erb -->

<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-purple-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-2xl mx-auto">
    
    <!-- Header -->
    <div class="mb-8">
      <%= link_to "Back to Students", students_path, class: "inline-flex items-center text-indigo-600 hover:text-indigo-700 font-semibold transition duration-200 mb-6" %>
      <h1 class="text-4xl font-bold bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent mb-2">Add New Student</h1>
      <p class="text-gray-600">Fill in the details below to create a new student record</p>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100">
      <div class="bg-gradient-to-r from-indigo-600 to-purple-600 px-8 py-6">
        <h2 class="text-2xl font-bold text-Black">Student Information</h2>
      </div>

      <div class="px-8 py-10">
        <%= render 'form' %>
      </div>
    </div>
  </div>
</div>