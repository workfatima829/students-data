<div class="max-w-3xl mx-auto p-6">
  <% if notice %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white shadow-lg rounded-lg overflow-hidden">
    <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-6 py-4">
      <h1 class="text-2xl font-bold text-white">Student Details</h1>
    </div>
    
    <div class="p-6 space-y-4">
      <div class="border-b pb-4">
        <label class="text-sm font-medium text-gray-500 uppercase tracking-wider">Name</label>
        <p class="text-lg text-gray-900 mt-1"><%= @student.name %></p>
      </div>
      
      <div class="border-b pb-4">
        <label class="text-sm font-medium text-gray-500 uppercase tracking-wider">Age</label>
        <p class="text-lg text-gray-900 mt-1"><%= @student.age %></p>
      </div>
      
      <div class="pb-4">
        <label class="text-sm font-medium text-gray-500 uppercase tracking-wider">Email</label>
        <p class="text-lg text-gray-900 mt-1"><%= @student.email %></p>
      </div>
    </div>

    <div class="bg-gray-50 px-6 py-4 flex justify-between items-center">
      <%= link_to "← Back to List", students_path, class: "text-blue-600 hover:text-blue-800 font-medium" %>
      <div class="space-x-3">
        <%= link_to "Edit", edit_student_path(@student), class: "bg-green-600 hover:bg-green-700 text-white font-semibold px-4 py-2 rounded transition duration-200" %>
        <%= link_to "Delete", student_path(@student), 
            data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this student?" }, 
            class: "bg-red-600 hover:bg-red-700 text-white font-semibold px-4 py-2 rounded transition duration-200" %>
      </div>
    </div>
  </div>
</div>