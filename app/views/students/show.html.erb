<h1 class="text-2xl font-bold mb-4">Student Details</h1>

<p><strong>Name:</strong> <%= @student.name %></p>
<p><strong>Age:</strong> <%= @student.age %></p>
<p><strong>Email:</strong> <%= @student.email %></p>

<a href="<%= students_path %>" class="text-blue-600 mt-4 inline-block">Back</a>
<a href="<%= edit_student_path(@student) %>" class="text-green-600 mt-4 ml-2 inline-block">Edit</a>
<%= link_to "Delete", student_path(@student), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 mt-4 ml-2 inline-block" %>
