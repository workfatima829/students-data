<!-- app/views/students/show.html.erb -->
<div class="bg-red-600 text-black p-4">
  Tailwind is working
</div>

<div class="min-h-screen bg-gray-100 flex items-center justify-center px-4">
  <div class="w-full max-w-2xl">

    <% if notice %>
      <div class="mb-5 rounded-md bg-green-50 border border-green-200 px-4 py-3 text-green-700 text-sm">
        <%= notice %>
      </div>
    <% end %>

    <!-- Card -->
    <div class="bg-white rounded-lg shadow-md border border-gray-200">

      <!-- Header -->
      <div class="px-6 py-5 border-b border-gray-200">
        <h1 class="text-2xl font-semibold text-gray-900">
          Student Details
        </h1>
        <p class="text-sm text-gray-500 mt-1">
          View student information
        </p>
      </div>

      <!-- Body -->
      <div class="px-6 py-6 space-y-6">

        <div>
          <p class="text-sm font-medium text-gray-500 mb-1">Full Name</p>
          <p class="text-lg text-gray-900 font-semibold">
            <%= @student.name %>
          </p>
        </div>

        <div>
          <p class="text-sm font-medium text-gray-500 mb-1">Age</p>
          <p class="text-gray-900">
            <span class="font-semibold"><%= @student.age %></span> years
          </p>
        </div>

        <div>
          <p class="text-sm font-medium text-gray-500 mb-1">Email</p>
          <a href="mailto:<%= @student.email %>"
             class="text-indigo-600 hover:text-indigo-800 font-medium">
            <%= @student.email %>
          </a>
        </div>

      </div>

      <!-- Footer / Actions -->
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-between">

        <%= link_to "Back",
          students_path,
          class: "inline-flex items-center px-4 py-2 rounded-md border border-gray-300 text-sm font-medium text-gray-700 bg-white hover:bg-gray-100 transition" %>

        <div class="space-x-2">
          <%= link_to "Edit",
            edit_student_path(@student),
            class: "inline-flex items-center px-4 py-2 rounded-md bg-indigo-600 text-sm font-medium text-black hover:bg-indigo-700 transition" %>

          <%= link_to "Delete",
            student_path(@student),
            method: :delete,
            data: { confirm: "Are you sure?" },
            class: "inline-flex items-center px-4 py-2 rounded-md bg-red-600 text-sm font-medium text-black hover:bg-red-700 transition" %>
        </div>
      </div>
    </div>
  </div>
</div>
