<!-- app/views/students/show.html.erb -->

<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-purple-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-2xl mx-auto">
    
    <!-- Success Message -->
    <% if notice %>
      <div class="mb-6 bg-emerald-50 border border-emerald-200 rounded-lg p-4 flex items-center gap-3">
        <span class="text-emerald-800 font-medium"><%= notice %></span>
      </div>
    <% end %>

    <!-- Back Button -->
    <%= link_to "← Back to Students", students_path, class: "inline-flex items-center text-indigo-600 hover:text-indigo-700 font-semibold mb-6 transition duration-200" %>

    <!-- Main Card -->
    <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100">
      
      <!-- Header with Gradient -->
      <div class="bg-gradient-to-r from-indigo-600 to-purple-600 px-8 py-12">
        <h1 class="text-4xl font-bold text-white mb-2"><%= @student.name %></h1>
        <p class="text-indigo-100">Student Profile</p>
      </div>

      <!-- Content -->
      <div class="px-8 py-10 space-y-8">
        
        <!-- Name -->
        <div class="border-b border-gray-100 pb-6">
          <label class="text-xs font-bold text-indigo-600 uppercase tracking-wider block mb-2">Full Name</label>
          <p class="text-2xl font-semibold text-gray-900"><%= @student.name %></p>
        </div>

        <!-- Age -->
        <div class="border-b border-gray-100 pb-6">
          <label class="text-xs font-bold text-indigo-600 uppercase tracking-wider block mb-2">Age</label>
          <div class="flex items-center gap-2">
            <span class="text-2xl font-semibold text-gray-900"><%= @student.age %></span>
            <span class="text-lg text-gray-500">years old</span>
          </div>
        </div>

        <!-- Email -->
        <div class="pb-6">
          <label class="text-xs font-bold text-indigo-600 uppercase tracking-wider block mb-2">Email Address</label>
          <a href="mailto:<%= @student.email %>" class="text-2xl font-semibold text-indigo-600 hover:text-indigo-700 transition duration-200">
            <%= @student.email %>
          </a>
        </div>
      </div>

      <!-- Actions Footer -->
      <div class="bg-gray-50 border-t border-gray-100 px-8 py-6">
        <div class="flex flex-col sm:flex-row gap-3">
          <%= link_to "← Back to List", students_path, class: "flex-1 text-center bg-white hover:bg-gray-100 text-gray-700 font-semibold py-3 px-4 rounded-lg border-2 border-gray-200 transition duration-200" %>
          <%= link_to "✏️ Edit", edit_student_path(@student), class: "flex-1 text-center bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-semibold py-3 px-4 rounded-lg transition duration-200 transform hover:shadow-lg" %>
          <%= link_to "🗑️ Delete", student_path(@student), method: :delete, data: { confirm: "Are you absolutely sure?" }, class: "flex-1 text-center bg-gradient-to-r from-red-500 to-rose-500 hover:from-red-600 hover:to-rose-600 text-white font-semibold py-3 px-4 rounded-lg transition duration-200 transform hover:shadow-lg" %>
        </div>
      </div>
    </div>
  </div>
</div>